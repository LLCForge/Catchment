{
    "##": "Scoop manifest for Catchment. @VERSION@ and @SHA256_*@ are filled in by the release workflow; checkver/autoupdate keep it current afterwards.",
    "version": "@VERSION@",
    "description": "Anycast catchment prober: maps which PoP each vantage point lands in and detects shifts",
    "homepage": "https://github.com/LLCForge/Catchment",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/LLCForge/Catchment/releases/download/v@VERSION@/catchment-@VERSION@-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256_X86_64_WINDOWS@"
        },
        "arm64": {
            "url": "https://github.com/LLCForge/Catchment/releases/download/v@VERSION@/catchment-@VERSION@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA256_AARCH64_WINDOWS@"
        }
    },
    "bin": "catchment.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/LLCForge/Catchment/releases/download/v$version/catchment-$version-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/LLCForge/Catchment/releases/download/v$version/catchment-$version-aarch64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}

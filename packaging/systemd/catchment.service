# Catchment systemd unit (hardened). Installed by the .deb/.rpm packages as
# /usr/lib/systemd/system/catchment.service. Secrets go in /etc/catchment/catchment.env
# (KEY=value, mode 0600, root-owned): systemd reads it before dropping privileges.
[Unit]
Description=Catchment - Anycast catchment prober: maps which PoP each vantage point lands in and detects shifts
Documentation=https://github.com/LLCForge/Catchment
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/catchment run --config /etc/catchment/catchment.toml
# SIGHUP triggers the llcforge-beacon ReloadSignal (config reload).
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=-/etc/catchment/catchment.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Identity and state: a transient UID, /var/lib/catchment exported as $STATE_DIRECTORY.
DynamicUser=yes
StateDirectory=catchment
StateDirectoryMode=0750
ConfigurationDirectory=catchment
WorkingDirectory=%S/catchment
UMask=0077

# Capabilities: none by default.
# A tool that binds a privileged port (< 1024, e.g. BGP on 179) needs:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
# A tool that sends raw ICMP / traceroute probes needs CAP_NET_RAW the same way.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# Filesystem and kernel isolation.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Network: IPv4/IPv6 plus AF_UNIX (local syslog socket, journald).
# Add AF_NETLINK only if the tool reads interface/route tables.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System calls.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

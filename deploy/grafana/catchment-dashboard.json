{
  "title": "Catchment",
  "uid": "llcforge-catchment",
  "tags": [
    "llcforge",
    "catchment"
  ],
  "description": "Anycast catchment prober: maps which PoP each vantage point lands in and detects shifts",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Instance",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "query": {
          "query": "label_values(llcforge_alert_received_total{tool=\"catchment\"}, instance)",
          "refId": "instance"
        },
        "current": {}
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Service",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "query": {
          "query": "label_values(catchment_rounds_total{instance=~\"$instance\"}, service)",
          "refId": "service"
        },
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Catchment on GitHub",
      "type": "link",
      "url": "https://github.com/LLCForge/Catchment"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Process",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{job=\"catchment\",instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alert queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(llcforge_alert_queue_depth{tool=\"catchment\",instance=~\"$instance\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(llcforge_alert_received_total{tool=\"catchment\",instance=~\"$instance\"}[24h]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dropped (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(llcforge_alert_dropped_total{tool=\"catchment\",instance=~\"$instance\"}[24h]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Alert pipeline",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Intake (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_alert_received_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_alert_deduplicated_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "deduplicated"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_alert_silenced_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "silenced"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_alert_dropped_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "dropped"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(llcforge_alert_invalid_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "invalid"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (llcforge_alert_queue_depth{tool=\"catchment\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Sinks",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Delivered per sink (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink, type) (rate(llcforge_alert_sink_sent_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{sink}} ({{type}})"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failures per sink (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink, type) (rate(llcforge_alert_sink_failed_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "{{sink}} ({{type}})"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending per sink",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (llcforge_alert_sink_queued{tool=\"catchment\",instance=~\"$instance\"})",
          "legendFormat": "{{sink}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Retries / rate-limit waits (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (rate(llcforge_alert_sink_retries_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "retries {{sink}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (sink) (rate(llcforge_alert_sink_rate_limited_total{tool=\"catchment\",instance=~\"$instance\"}[5m])) * 60",
          "legendFormat": "rate-limited {{sink}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Catchment",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },

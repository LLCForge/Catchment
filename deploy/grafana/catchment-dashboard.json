      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service, pop, family) (catchment_vantages{instance=~\"$instance\",service=~\"$service\"})",
          "legendFormat": "{{service}} {{pop}} {{family}}"
        }
